{
  "name": "geometry-wars-3d-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Geometry Wars 3: Dimensions-style 3D twin-stick shooter (Three.js + TypeScript) — v2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:original": "node scripts/original-sim-harness.cjs",
    "golden:verify": "node scripts/original-sim-harness.cjs --verify tests/golden/original-sim-trajectory.json"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.0"
  }
}
